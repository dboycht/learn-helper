<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LearnHelper.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================
                 COLOUR TOKENS - PLAIN RESOURCES, NOT ThemeDictionaries.

                 This is deliberate and load-bearing. These keys used to live in
                 ThemeDictionaries while MainWindow.xaml referenced them with
                 {ThemeResource ...}. Two sources then fought over the same key:
                   * WinUI re-resolved ThemeResource on every runtime theme change and
                     took the ThemeDictionaries value;
                   * the app injected its palette into Application.Current.Resources.
                 WinUI's re-resolution ran last, so the injected colours were
                 overwritten - every surface came out EXACTLY inverted on a hot theme
                 switch while a cold start looked correct. Measured: the dark theme
                 rendered rgb(220..231) surfaces and the light theme rgb(32..48).

                 So there is now ONE source of truth: plain resources here, referenced
                 with {StaticResource ...} (resolved once, never re-resolved), and
                 GlassPalette.cs writes the live values into Application.Current.Resources
                 on every appearance change. Theme switching is therefore driven entirely
                 by code and cannot be clobbered by the framework.

                 The values below are only parse-time defaults; the first paint replaces
                 all 16 of them.

                 Run contrast_check.py after changing any colour, and see ERROR.md E22.
                 ============================================================ -->
            <SolidColorBrush x:Key="GlassBaseBrush" Color="#FF101418" />
            <SolidColorBrush x:Key="GlassDeepBrush" Color="#FF0B0E12" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="#D9171C22" />
            <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#FF171C22" />
            <SolidColorBrush x:Key="GlassCardHiBrush" Color="#FF1C222A" />
            <SolidColorBrush x:Key="GlassDividerBrush" Color="#FF252C35" />
            <SolidColorBrush x:Key="GlassAccentBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="GlassAccentFillBrush" Color="#FF0A6CA8" />
            <SolidColorBrush x:Key="GlassAccentSoftBrush" Color="#FF1A3A4D" />
            <SolidColorBrush x:Key="GlassOnAccentBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="GlassTextMainBrush" Color="#FFE8EDF2" />
            <SolidColorBrush x:Key="GlassTextSubBrush" Color="#FFB8C2CE" />
            <SolidColorBrush x:Key="GlassTextMutedBrush" Color="#FF8B96A5" />
            <SolidColorBrush x:Key="GlassSuccessBrush" Color="#FF3DDC97" />
            <SolidColorBrush x:Key="GlassWarnBrush" Color="#FFFFC24B" />
            <SolidColorBrush x:Key="GlassDangerBrush" Color="#FFFF6B6B" />
            <SolidColorBrush x:Key="GlassLogBrush" Color="#FF171C22" />

            <CornerRadius x:Key="GlassCardRadius">14</CornerRadius>
            <CornerRadius x:Key="GlassControlRadius">8</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
