<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LearnHelper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Single source of truth for the UI version, surfaced in the title bar.
         2.1.1 = 界面重构为原生 Rust Win32（native/）；本 WinUI 版作为**备选退路**保留
         （memory/02 §5：被否掉的技术线不要立刻删，直到新线稳定）。
         Keep in step with backend/learn_helper/config.py's APP_VERSION at release time. -->
    <Version>2.1.1</Version>
    <InformationalVersion>2.1.1</InformationalVersion>
    <!-- memory/03 section 1: unpackaged + self-contained, no MSIX, no certificate. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Needed for COM interop (named pipe / shell APIs are not COM, but keep for later). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <!-- XAML compiler diagnostics are easier to read without the trimming noise. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the versions already present in the local NuGet cache, so the first
         build needs no network. Bump deliberately (and re-verify the toolchain). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

</Project>
