<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LearnHelper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Single source of truth for the UI version, surfaced in the title bar.
         2.1.4 = 一轮 bug 排查与健壮性加固（原生 UI）；
         2.1.3 = 「只刷视频」/ Ctrl+V 粘贴 / 点设置不再闪退（原生 UI）；
         本 WinUI 版作为**备选退路**保留
         （memory/02 §5：被否掉的技术线不要立刻删，直到新线稳定）。
         Keep in step with backend/learn_helper/config.py's APP_VERSION at release time. -->
    <Version>2.1.4</Version>
    <InformationalVersion>2.1.4</InformationalVersion>
    <!-- memory/03 section 1: unpackaged + self-contained, no MSIX, no certificate. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Needed for COM interop (named pipe / shell APIs are not COM, but keep for later). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <!-- XAML compiler diagnostics are easier to read without the trimming noise. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the versions already present in the local NuGet cache, so the first
         build needs no network. Bump deliberately (and re-verify the toolchain). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Shared application icon (multi-size: 16/24/32/48/64/128/256).
         This line belongs to the FALLBACK WinUI line: the default product since 2.1.1 is the
         native Rust UI, which gets its icon stamped into the exe by native\build_release.ps1
         (see native\icon_probe.ps1 for the regression check). -->
    <ApplicationIcon>..\native\logo.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
